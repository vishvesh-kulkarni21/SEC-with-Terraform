# Copy this file to .env and fill in real values. .env is gitignored.

# Required by SEC: identifies who is making requests to EDGAR.
SEC_USER_AGENT="Vishvesh Kulkarni vishveshk21@gmail.com"

# Where cached EDGAR responses are stored.
CACHE_DIR=.cache

# Model access (Google AI Studio key: https://aistudio.google.com -> Get API key)
GEMINI_API_KEY=
# Pinned model IDs; change here to compare models.
EMBEDDING_MODEL=gemini-embedding-001
CHAT_MODEL=gemini-2.5-flash
# On Cloud Run, set VERTEX_PROJECT to use Vertex AI (service account) instead of an API key.
# VERTEX_PROJECT=
# VERTEX_LOCATION=us-central1
